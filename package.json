{
  "name": "pdd-city",
  "version": "0.3.0-preview.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:code && npm run lint:styles",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run test:e2e:legacy && npm run test:e2e:city",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:code": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0 && stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "fix": "npm run lint:fix && npm run format",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "city:plan": "node scripts/generate-city-plan.mjs",
    "test:e2e:city": "playwright test --config playwright.city.config.ts",
    "test:e2e:legacy": "playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^1.53.0",
    "phaser": "3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "patch-package": "8.0.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
